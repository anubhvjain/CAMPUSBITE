# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (used by docker-compose for both the db and backend services)
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_DB=campusbite

# JWT - use a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# OpenAI (AI order insights)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Background reminder task
REMINDER_THRESHOLD_MINUTES=15
REMINDER_INTERVAL_SECONDS=60
